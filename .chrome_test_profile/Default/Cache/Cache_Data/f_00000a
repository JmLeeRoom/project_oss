// Cogito++ Web Dashboard Frontend Client (§12-5, §12-8, §12-10 Compliant)

let eventSource = null;
let currentPendingApproval = null;
let isApproveConfirmArmed = false;
let approvalCountdownInterval = null;
let currentEpochId = null;
let csrfToken = 'cogito_csrf_' + Math.random().toString(36).substring(2);

// Initialize Dashboard
document.addEventListener('DOMContentLoaded', () => {
  initPlantClock();
  initSSE();
  fetchInitialData();
  setupEventHandlers();
});

// 1. Plant Clock (§12-12: Plant Local Time + Timezone Label)
function initPlantClock() {
  const clockEl = document.getElementById('plant-clock');
  function update() {
    const now = new Date();
    const year = now.getFullYear();
    const month = String(now.getMonth() + 1).padStart(2, '0');
    const day = String(now.getDate()).padStart(2, '0');
    const hours = String(now.getHours()).padStart(2, '0');
    const minutes = String(now.getMinutes()).padStart(2, '0');
    const seconds = String(now.getSeconds()).padStart(2, '0');
    if (clockEl) {
      clockEl.textContent = `${year}-${month}-${day} ${hours}:${minutes}:${seconds} KST (UTC+09:00)`;
    }
  }
  update();
  setInterval(update, 1000);
}

// 2. Server-Sent Events (SSE) Client (§12-7 / W6)
function initSSE() {
  console.log('[Dashboard] Initializing SSE connection to /api/events...');
  if (eventSource) {
    eventSource.close();
  }

  eventSource = new EventSource('/api/events');

  eventSource.onopen = () => {
    console.log('[Dashboard] SSE connection established');
    updateSseIndicator(true);
  };

  eventSource.addEventListener('state_change', (e) => {
    try {
      const data = JSON.parse(e.data);
      if (data.to) {
        updateFSMState(data.to);
      }
      if (data.session_id) {
        const sessEl = document.getElementById('session-id');
        if (sessEl) sessEl.textContent = data.session_id.slice(0, 8) + '...';
      }
    } catch (err) {
      console.error('[Dashboard] Error parsing state_change event:', err);
    }
  });

  eventSource.addEventListener('pending_approval', (e) => {
    try {
      const data = JSON.parse(e.data);
      showApprovalModal(data);
    } catch (err) {
      console.error('[Dashboard] Error parsing pending_approval event:', err);
    }
  });

  eventSource.addEventListener('audit_event', (e) => {
    try {
      const data = JSON.parse(e.data);
      prependAuditRow(data);
    } catch (err) {
      console.error('[Dashboard] Error parsing audit_event event:', err);
    }
  });

  eventSource.addEventListener('agent_message', (e) => {
    try {
      const data = JSON.parse(e.data);
      appendChatMessage(data.role, data.content);
    } catch (err) {
      console.error('[Dashboard] Error parsing agent_message event:', err);
    }
  });

  eventSource.addEventListener('verdict', (e) => {
    try {
      const data = JSON.parse(e.data);
      handleVerdictEvent(data);
    } catch (err) {
      console.error('[Dashboard] Error parsing verdict event:', err);
    }
  });

  eventSource.onerror = (err) => {
    console.warn('[Dashboard] SSE connection error/closed:', err);
    updateSseIndicator(false);
  };
}

function updateSseIndicator(connected) {
  const indicator = document.getElementById('sse-indicator');
  if (!indicator) return;
  indicator.textContent = '';
  const dot = document.createElement('span');
  dot.className = connected
    ? 'w-2 h-2 rounded-full bg-emerald-400 animate-pulse'
    : 'w-2 h-2 rounded-full bg-rose-500';
  indicator.appendChild(dot);
  indicator.appendChild(document.createTextNode(connected ? ' Connected' : ' Reconnecting...'));
  indicator.className = connected
    ? 'flex items-center gap-1.5 text-emerald-400 font-medium text-xs'
    : 'flex items-center gap-1.5 text-rose-400 font-medium text-xs';
}

// 3. FSM Visualizer Updater (10 Canonical States: §4-10)
function updateFSMState(stateName) {
  const badge = document.getElementById('fsm-badge');
  if (badge) {
    badge.textContent = stateName;
    if (stateName === 'AwaitApproval') {
      badge.className = 'px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-amber-500/20 text-amber-300 border border-amber-500/40';
    } else if (stateName === 'Infer' || stateName === 'Propose' || stateName === 'Gate') {
      badge.className = 'px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-blue-500/20 text-blue-300 border border-blue-500/40';
    } else if (stateName === 'Execute') {
      badge.className = 'px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-purple-500/20 text-purple-300 border border-purple-500/40';
    } else if (stateName === 'Failed' || stateName === 'Cancelled') {
      badge.className = 'px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-rose-500/20 text-rose-300 border border-rose-500/40';
    } else {
      badge.className = 'px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/40';
    }
  }

  // Update SVG Nodes
  const canonicalStates = ['Idle', 'Infer', 'Propose', 'Gate', 'AwaitApproval', 'Execute', 'Observe', 'Done', 'Failed', 'Cancelled'];
  canonicalStates.forEach(name => {
    const el = document.getElementById(`node-${name}`);
    if (el) {
      if (name === stateName) {
        el.classList.add('fsm-active');
      } else {
        el.classList.remove('fsm-active');
      }
    }
  });
}

// 4. Approval Modal Logic (§12-8 [A-1]~[A-8])
function showApprovalModal(data) {
  currentPendingApproval = data;
  isApproveConfirmArmed = false;
  resetApproveButtonState();

  const toolEl = document.getElementById('modal-tool-name');
  if (toolEl) toolEl.textContent = data.tool_name || 'opcua.write_parameter';

  const riskBadge = document.getElementById('modal-risk-badge');
  if (riskBadge) {
    if (data.effect === 'write' || data.effect === 'destructive') {
      riskBadge.textContent = `설비 변경 · 위험도 ${data.risk === 'critical' ? '치명적' : '높음'}`;
      riskBadge.className = 'text-[10px] font-bold text-rose-400 bg-rose-500/20 px-1.5 py-0.5 rounded border border-rose-500/40';
    } else {
      riskBadge.textContent = `읽기 전용 · 위험도 낮음`;
      riskBadge.className = 'text-[10px] font-bold text-emerald-400 bg-emerald-500/20 px-1.5 py-0.5 rounded border border-emerald-500/40';
    }
  }

  const grammarBadge = document.getElementById('modal-grammar-badge');
  if (grammarBadge) {
    if (data.grammar_coverage === 'full') {
      grammarBadge.textContent = '문법 제약 완전 적용 (Tier-G)';
      grammarBadge.className = 'text-[10px] text-emerald-400 block font-medium';
    } else {
      grammarBadge.textContent = '생성 단계 제약 없음 — 런타임 검증만 적용됨 [A-3]';
      grammarBadge.className = 'text-[10px] text-amber-300 block font-medium';
    }
  }

  const policyRuleEl = document.getElementById('modal-policy-rule');
  if (policyRuleEl) policyRuleEl.textContent = `rule: ${data.policy_rule_id || 'default'}`;

  // Parameter table [A-7]
  const tbody = document.getElementById('modal-param-table-body');
  if (tbody) {
    tbody.textContent = '';
    const beforeObj = data.before || {};
    const reqObj = data.canonical_arguments || {};
    const allKeys = Array.from(new Set([...Object.keys(beforeObj), ...Object.keys(reqObj)]));

    allKeys.forEach(k => {
      const tr = document.createElement('tr');
      const tdKey = document.createElement('td');
      tdKey.className = 'py-1 px-3 font-semibold text-white';
      tdKey.textContent = k;

      const tdBefore = document.createElement('td');
      tdBefore.className = 'py-1 px-3 text-emerald-400';
      tdBefore.textContent = beforeObj[k] !== undefined ? JSON.stringify(beforeObj[k]) : '-';

      const tdReq = document.createElement('td');
      tdReq.className = 'py-1 px-3 text-amber-300 font-bold';
      tdReq.textContent = reqObj[k] !== undefined ? JSON.stringify(reqObj[k]) : '-';

      tr.appendChild(tdKey);
      tr.appendChild(tdBefore);
      tr.appendChild(tdReq);
      tbody.appendChild(tr);
    });
  }

  // Untrusted box [A-4]
  const untrustedTextEl = document.getElementById('modal-untrusted-text');
  if (untrustedTextEl) {
    untrustedTextEl.textContent = data.untrusted_context?.raw_text || '(모델 외부 텍스트 없음)';
  }
  const provenanceEl = document.getElementById('modal-provenance');
  if (provenanceEl) {
    provenanceEl.textContent = `provenance: ${data.untrusted_context?.provenance || 'agent_inference'}`;
  }

  // Action digest [A-1]
  const digestEl = document.getElementById('modal-action-digest-prefix');
  if (digestEl) {
    const fullHex = data.action_digest_hex || '';
    digestEl.textContent = fullHex.slice(0, 16);
    digestEl.title = fullHex;
  }

  // Expiration countdown [A-6]
  startCountdown(data.expires_in_ms || 120000);

  const modal = document.getElementById('approval-modal');
  if (modal) modal.classList.remove('hidden');
}

function startCountdown(durationMs) {
  if (approvalCountdownInterval) {
    clearInterval(approvalCountdownInterval);
  }
  let remainingMs = durationMs;
  const countdownEl = document.getElementById('modal-expires-countdown');

  function tick() {
    remainingMs = Math.max(0, remainingMs - 100);
    if (countdownEl) {
      countdownEl.textContent = `${(remainingMs / 1000).toFixed(1)}s`;
    }
    if (remainingMs <= 0) {
      clearInterval(approvalCountdownInterval);
      if (countdownEl) countdownEl.textContent = '만료됨 (Expired)';
    }
  }
  tick();
  approvalCountdownInterval = setInterval(tick, 100);
}

function hideApprovalModal() {
  const modal = document.getElementById('approval-modal');
  if (modal) modal.classList.add('hidden');
  if (approvalCountdownInterval) {
    clearInterval(approvalCountdownInterval);
    approvalCountdownInterval = null;
  }
  currentPendingApproval = null;
  isApproveConfirmArmed = false;
  resetApproveButtonState();
}

function resetApproveButtonState() {
  const approveText = document.getElementById('btn-approve-text');
  const btnApprove = document.getElementById('btn-modal-approve');
  if (approveText) approveText.textContent = '승인 (Approve)';
  if (btnApprove) {
    btnApprove.className = 'h-14 min-w-[140px] px-6 rounded-xl font-bold text-sm bg-emerald-600 text-white border-2 border-emerald-400 hover:bg-emerald-500 shadow-lg shadow-emerald-600/30 transition-all flex items-center justify-center gap-2 active:scale-95';
  }
}

// 5. User Turn Submission (POST /api/turn — 202 Accepted)
async function sendAgentTurn(message) {
  if (!message.trim()) return;
  appendChatMessage('user', message);

  const commandId = crypto.randomUUID ? crypto.randomUUID() : ('cmd_' + Date.now());

  try {
    const res = await fetch('/api/turn', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-Cogito-CSRF': csrfToken
      },
      body: JSON.stringify({
        command_id: commandId,
        message: message
      })
    });
    if (!res.ok) {
      const errData = await res.json().catch(() => ({}));
      appendChatMessage('assistant', `[요청 거부] 상태 ${res.status}: ${errData.error || '오류 발생'}`);
    }
  } catch (err) {
    console.error('[Dashboard] sendAgentTurn error:', err);
    appendChatMessage('assistant', `[통신 오류] 서버와 통신할 수 없습니다: ${err.message}`);
  }
}

// 6. Respond to Approval (POST /api/approve / POST /api/reject — 2-Step Confirmation [A-5])
async function respondApproval(decision, reason = '') {
  if (!currentPendingApproval) return;
  const pending = currentPendingApproval;

  if (decision === 'Approved') {
    // 2-Step Confirmation [A-5]
    if (!isApproveConfirmArmed) {
      isApproveConfirmArmed = true;
      const approveText = document.getElementById('btn-approve-text');
      const btnApprove = document.getElementById('btn-modal-approve');
      if (approveText) approveText.textContent = '⚠️ 최종 확인: 실행합니까?';
      if (btnApprove) {
        btnApprove.className = 'h-14 min-w-[140px] px-6 rounded-xl font-bold text-sm bg-amber-600 text-white border-2 border-amber-400 hover:bg-amber-500 shadow-lg shadow-amber-600/40 transition-all flex items-center justify-center gap-2 active:scale-95 animate-pulse';
      }
      return;
    }
  }

  hideApprovalModal();

  const endpoint = decision === 'Approved' ? '/api/approve' : '/api/reject';
  const payload = {
    approval_id: pending.pending_approval_id,
    action_digest_hex: pending.action_digest_hex,
    nonce: pending.nonce
  };
  if (decision === 'Rejected') {
    payload.reason = reason || 'Operator clicked Reject in HMI';
  }

  try {
    const res = await fetch(endpoint, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-Cogito-CSRF': csrfToken
      },
      body: JSON.stringify(payload)
    });
    const result = await res.json().catch(() => ({}));
    console.log('[Dashboard] Approval POST response:', res.status, result);
  } catch (err) {
    console.error('[Dashboard] respondApproval error:', err);
  }
}

// 7. Verdict Event Handler [A-8]
function handleVerdictEvent(verdictData) {
  console.log('[Dashboard] Verdict event received:', verdictData);
  if (verdictData.verdict === 'denied' || verdictData.reason_code === 'tool_forbidden') {
    appendChatMessage('assistant', `[차단 결과] 사유: ${verdictData.reason_code || 'policy_denied'} - 실행 거부됨 (write 0회)`);
  } else if (verdictData.verdict === 'rejected') {
    appendChatMessage('assistant', `[거부 완료] 작업자가 승인을 거부했습니다. (사유: ${verdictData.reason || 'approval_rejected'}, write 0회)`);
  } else if (verdictData.verdict === 'allowed' || verdictData.verdict === 'approved_and_executed') {
    appendChatMessage('assistant', `[실행 완료] 도구 ${verdictData.tool_name || ''} 작업이 승인되어 성공적으로 커밋되었습니다.`);
  }
}

// 8. UI Helpers (Strict textContent usage for zero XSS: §12-10 M-1)
function appendChatMessage(role, text) {
  const container = document.getElementById('chat-messages');
  if (!container) return;

  const msgDiv = document.createElement('div');
  msgDiv.className = `chat-msg ${role === 'user' ? 'chat-user' : 'chat-assistant'}`;

  const senderSpan = document.createElement('span');
  senderSpan.className = `chat-sender ${role === 'user' ? 'text-blue-400' : 'text-emerald-400'} font-semibold`;
  senderSpan.textContent = role === 'user' ? '작업자 (Operator)' : 'Cogito++ Agent';

  const contentP = document.createElement('p');
  contentP.className = 'whitespace-pre-wrap';
  contentP.textContent = text;

  msgDiv.appendChild(senderSpan);
  msgDiv.appendChild(contentP);
  container.appendChild(msgDiv);

  container.scrollTop = container.scrollHeight;
}

function prependAuditRow(log) {
  const tbody = document.getElementById('audit-table-body');
  if (!tbody) return;

  const tr = document.createElement('tr');
  tr.className = 'hover:bg-white/5 transition-colors';

  const tdSeq = document.createElement('td');
  tdSeq.className = 'py-2 px-3 font-semibold text-white';
  tdSeq.textContent = `#${log.seq}`;

  const tdTurn = document.createElement('td');
  tdTurn.className = 'py-2 px-3 text-industrial-muted';
  tdTurn.textContent = `T${log.turn_id || '-'}`;

  const tdTool = document.createElement('td');
  tdTool.className = 'py-2 px-3 text-cyan-300';
  tdTool.textContent = log.tool_name || log.event_type || log.kind || '-';

  const tdVerdict = document.createElement('td');
  tdVerdict.className = 'py-2 px-3';
  const badge = document.createElement('span');
  if (log.verdict === 'allowed' || log.verdict === 'approved_and_executed') {
    badge.className = 'text-emerald-400 bg-emerald-500/10 px-1.5 py-0.5 rounded border border-emerald-500/30';
    badge.textContent = 'Allow';
  } else if (log.verdict === 'rejected') {
    badge.className = 'text-amber-400 bg-amber-500/10 px-1.5 py-0.5 rounded border border-amber-500/30';
    badge.textContent = 'Reject';
  } else {
    badge.className = 'text-rose-400 bg-rose-500/10 px-1.5 py-0.5 rounded border border-rose-500/30';
    badge.textContent = 'Deny';
  }
  tdVerdict.appendChild(badge);

  const tdDigest = document.createElement('td');
  tdDigest.className = 'py-2 px-3 text-industrial-muted text-[10px] truncate max-w-[120px] font-mono';
  if (log.action_digest) {
    tdDigest.textContent = log.action_digest.slice(0, 12) + '...';
    tdDigest.title = log.action_digest;
  } else {
    tdDigest.textContent = '-';
  }

  const tdLatency = document.createElement('td');
  tdLatency.className = 'py-2 px-3 text-industrial-accent';
  tdLatency.textContent = log.latency_us ? `${log.latency_us}µs` : '-';

  tr.appendChild(tdSeq);
  tr.appendChild(tdTurn);
  tr.appendChild(tdTool);
  tr.appendChild(tdVerdict);
  tr.appendChild(tdDigest);
  tr.appendChild(tdLatency);

  tbody.insertBefore(tr, tbody.firstChild);
}

// 9. Fetch Initial Data (REST: §12-5)
async function fetchInitialData() {
  try {
    // 1. State
    const stateRes = await fetch('/api/state');
    if (stateRes.ok) {
      const stateData = await stateRes.json();
      currentEpochId = stateData.process_epoch_id;
      const sessEl = document.getElementById('session-id');
      if (sessEl) sessEl.textContent = (stateData.session_id || '').slice(0, 8) + '...';
      const modeEl = document.getElementById('exec-mode');
      if (modeEl) modeEl.textContent = stateData.mode || 'Default';
      updateFSMState(stateData.state || 'Idle');
    }

    // 2. Pending Approvals
    const pendingRes = await fetch('/api/approvals/pending');
    if (pendingRes.ok) {
      const pendingData = await pendingRes.json();
      if (pendingData.approvals && pendingData.approvals.length > 0) {
        showApprovalModal(pendingData.approvals[0]);
      }
    }

    // 3. Tools
    const toolsRes = await fetch('/api/tools');
    if (toolsRes.ok) {
      const toolsData = await toolsRes.json();
      renderToolsList(toolsData.tools || []);
    }

    // 4. Audit Logs
    const auditRes = await fetch('/api/audit?limit=20');
    if (auditRes.ok) {
      const auditData = await auditRes.json();
      const tbody = document.getElementById('audit-table-body');
      if (tbody) tbody.textContent = '';
      (auditData.logs || []).forEach(log => prependAuditRow(log));
    }
  } catch (err) {
    console.error('[Dashboard] fetchInitialData error:', err);
  }
}

function renderToolsList(tools) {
  const container = document.getElementById('tools-list');
  if (!container) return;
  container.textContent = '';

  tools.forEach(tool => {
    const item = document.createElement('div');
    item.className = 'bg-industrial-darker p-2.5 rounded-lg border border-industrial-border flex items-center justify-between text-xs';
    
    const leftDiv = document.createElement('div');
    const nameDiv = document.createElement('div');
    nameDiv.className = 'font-mono font-semibold text-white flex items-center gap-2';
    nameDiv.textContent = tool.name;

    if (tool.status === 'forbidden') {
      const forbidBadge = document.createElement('span');
      forbidBadge.className = 'px-1.5 py-0.5 rounded bg-red-950 text-rose-300 border border-rose-800 text-[10px]';
      forbidBadge.textContent = 'Forbidden';
      nameDiv.appendChild(forbidBadge);
    }

    const descP = document.createElement('p');
    descP.className = 'text-industrial-muted text-[11px] mt-0.5';
    descP.textContent = tool.description;

    leftDiv.appendChild(nameDiv);
    leftDiv.appendChild(descP);

    const rightDiv = document.createElement('div');
    rightDiv.className = 'flex items-center gap-1.5 shrink-0';
    const riskBadge = document.createElement('span');
    if (tool.risk === 'high' || tool.risk === 'critical') {
      riskBadge.className = 'px-1.5 py-0.5 rounded bg-rose-500/20 text-rose-400 border border-rose-500/30 text-[10px] font-bold uppercase';
    } else {
      riskBadge.className = 'px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 text-[10px] font-bold uppercase';
    }
    riskBadge.textContent = tool.risk;
    rightDiv.appendChild(riskBadge);

    item.appendChild(leftDiv);
    item.appendChild(rightDiv);
    container.appendChild(item);
  });
}

// 10. Event Handlers Setup
function setupEventHandlers() {
  document.getElementById('btn-scenario-ask')?.addEventListener('click', () => {
    sendAgentTurn('불량 검사 임계값을 0.80에서 0.95로 변경해줘');
  });

  document.getElementById('btn-scenario-allow')?.addEventListener('click', () => {
    sendAgentTurn('최근 1시간 검사 결과 및 불량률 조회해줘');
  });

  document.getElementById('btn-scenario-deny')?.addEventListener('click', () => {
    sendAgentTurn('감사 로그 영구 강제 삭제해줘');
  });

  document.getElementById('chat-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const input = document.getElementById('chat-input');
    if (input && input.value.trim()) {
      sendAgentTurn(input.value.trim());
      input.value = '';
    }
  });

  document.getElementById('btn-modal-approve')?.addEventListener('click', () => {
    respondApproval('Approved');
  });

  document.getElementById('btn-modal-reject')?.addEventListener('click', () => {
    respondApproval('Rejected');
  });
}

