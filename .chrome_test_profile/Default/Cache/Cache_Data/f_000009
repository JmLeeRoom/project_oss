<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; upgrade-insecure-requests">
  <title>Cogito++ Industrial AI Agent HMI Dashboard</title>
  <link rel="stylesheet" href="style.css">
</head>
<body class="bg-industrial-dark text-industrial-text font-sans">
  <div class="h-screen w-screen flex flex-col overflow-hidden">
    <!-- Top Invariant 13 Banner (§12-12 / 불변식 13) -->
    <div id="safety-banner" class="bg-amber-950/80 border-b border-amber-500/40 px-4 py-1 text-center text-xs font-semibold text-amber-200 tracking-wide shrink-0">
      ⚠️ 승인 기반 상위 수준 작업 — 안전 계통(Safety Interlock / PLC)은 기존 인증 체계가 담당합니다. (불변식 13)
    </div>

    <!-- Top Navigation Header -->
    <header class="h-14 border-b border-industrial-border bg-industrial-panel px-6 flex items-center justify-between shrink-0">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center font-bold text-emerald-400">
          C++
        </div>
        <div>
          <h1 class="text-base font-semibold tracking-wide text-white flex items-center gap-2">
            Cogito++ Agent Core
            <span class="text-xs px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">HMI Host v1.1</span>
          </h1>
        </div>
      </div>
      
      <div class="flex items-center gap-6 text-xs">
        <div class="flex items-center gap-2">
          <span class="text-industrial-muted">공장 현지시각:</span>
          <span id="plant-clock" class="font-mono text-white font-medium">2026-08-24 09:27:00 KST (UTC+09:00)</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-industrial-muted">Session:</span>
          <span id="session-id" class="font-mono text-industrial-accent">Connecting...</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-industrial-muted">Mode:</span>
          <span id="exec-mode" class="px-2 py-0.5 rounded bg-blue-500/10 text-blue-400 border border-blue-500/30 font-mono">Default</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-industrial-muted">SSE Stream:</span>
          <span id="sse-indicator" class="flex items-center gap-1.5 text-emerald-400 font-medium">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Connected
          </span>
        </div>
      </div>
    </header>

    <!-- Main Content Grid -->
    <div class="flex-1 grid grid-cols-12 gap-4 p-4 min-h-0 overflow-hidden">
      <!-- Left Column: FSM Visualizer & Quick Actions (5 cols) -->
      <div class="col-span-5 flex flex-col gap-4 min-h-0">
        <!-- FSM Graph Card (§12-9: Driven strictly from /api/transitions) -->
        <div class="bg-industrial-panel border border-industrial-border rounded-xl p-4 flex flex-col">
          <div class="flex items-center justify-between mb-3">
            <h2 class="text-sm font-semibold text-white flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <polygon points="10 8 16 12 10 16 10 8"></polygon>
              </svg>
              AgentLoop FSM (10 Canonical States)
            </h2>
            <span id="fsm-badge" class="px-2.5 py-0.5 rounded-full text-xs font-mono font-semibold bg-emerald-500/20 text-emerald-400 border border-emerald-500/40">
              Idle
            </span>
          </div>

          <!-- Pure SVG State Diagram (100% CSP compliant, zero inline styles) -->
          <div class="w-full h-36 bg-industrial-darker rounded-lg border border-industrial-border/60 flex items-center justify-center p-1 overflow-hidden">
            <svg id="fsm-svg" class="w-full h-full" viewBox="0 0 740 100">
              <!-- Connectors -->
              <line x1="45" y1="50" x2="115" y2="50" class="fsm-edge"></line>
              <line x1="115" y1="50" x2="185" y2="50" class="fsm-edge"></line>
              <line x1="185" y1="50" x2="255" y2="50" class="fsm-edge"></line>
              <line x1="255" y1="30" x2="335" y2="25" class="fsm-edge"></line>
              <line x1="255" y1="70" x2="415" y2="70" class="fsm-edge"></line>
              <line x1="335" y1="25" x2="415" y2="25" class="fsm-edge"></line>
              <line x1="415" y1="50" x2="495" y2="50" class="fsm-edge"></line>
              <line x1="495" y1="50" x2="575" y2="50" class="fsm-edge"></line>
              <line x1="575" y1="30" x2="655" y2="25" class="fsm-edge"></line>
              <line x1="575" y1="70" x2="655" y2="75" class="fsm-edge"></line>
              <path d="M 655 50 C 655 95, 45 95, 45 50" class="fsm-edge fsm-edge-loop"></path>

              <!-- State Nodes: 10 Canonical States (§4-10) -->
              <!-- 1. Idle -->
              <g id="node-Idle" class="fsm-node fsm-active">
                <circle cx="45" cy="50" r="18" class="node-bg"></circle>
                <text x="45" y="54" class="node-text">Idle</text>
              </g>

              <!-- 2. Infer -->
              <g id="node-Infer" class="fsm-node">
                <circle cx="115" cy="50" r="18" class="node-bg"></circle>
                <text x="115" y="54" class="node-text">Infer</text>
              </g>

              <!-- 3. Propose -->
              <g id="node-Propose" class="fsm-node">
                <circle cx="185" cy="50" r="18" class="node-bg"></circle>
                <text x="185" y="54" class="node-text">Prop</text>
              </g>

              <!-- 4. Gate -->
              <g id="node-Gate" class="fsm-node">
                <circle cx="255" cy="50" r="18" class="node-bg"></circle>
                <text x="255" y="54" class="node-text">Gate</text>
              </g>

              <!-- 5. AwaitApproval -->
              <g id="node-AwaitApproval" class="fsm-node">
                <circle cx="335" cy="25" r="18" class="node-bg node-ask"></circle>
                <text x="335" y="29" class="node-text text-ask">Ask</text>
              </g>

              <!-- 6. Execute -->
              <g id="node-Execute" class="fsm-node">
                <circle cx="415" cy="50" r="18" class="node-bg"></circle>
                <text x="415" y="54" class="node-text">Exec</text>
              </g>

              <!-- 7. Observe -->
              <g id="node-Observe" class="fsm-node">
                <circle cx="495" cy="50" r="18" class="node-bg"></circle>
                <text x="495" y="54" class="node-text">Obs</text>
              </g>

              <!-- 8. Done -->
              <g id="node-Done" class="fsm-node">
                <circle cx="575" cy="50" r="18" class="node-bg"></circle>
                <text x="575" y="54" class="node-text">Done</text>
              </g>

              <!-- 9. Failed -->
              <g id="node-Failed" class="fsm-node">
                <circle cx="655" cy="25" r="18" class="node-bg"></circle>
                <text x="655" y="29" class="node-text">Fail</text>
              </g>

              <!-- 10. Cancelled -->
              <g id="node-Cancelled" class="fsm-node">
                <circle cx="655" cy="75" r="18" class="node-bg"></circle>
                <text x="655" y="79" class="node-text">Canc</text>
              </g>
            </svg>
          </div>
        </div>

        <!-- Quick Interactive Scenarios -->
        <div class="bg-industrial-panel border border-industrial-border rounded-xl p-4 flex flex-col gap-2.5">
          <h2 class="text-sm font-semibold text-white flex items-center gap-2 mb-1">
            <svg class="w-4 h-4 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
            현장 시나리오 즉시 실행 (POST /api/turn)
          </h2>
          
          <button id="btn-scenario-ask" class="scenario-btn btn-ask-border">
            <div class="flex items-center justify-between">
              <span class="font-medium text-amber-300">① 검사 임계값 변경 (Write/High Risk)</span>
              <span class="scenario-tag bg-amber-500/20 text-amber-400 border-amber-500/40">Decision::Ask</span>
            </div>
            <p class="text-xs text-industrial-muted mt-1">임계값을 0.80에서 0.95로 변경 시도 -> 작업자 승인 팝업 유발</p>
          </button>

          <button id="btn-scenario-allow" class="scenario-btn btn-allow-border">
            <div class="flex items-center justify-between">
              <span class="font-medium text-emerald-300">② 최근 불량 통계 조회 (Read/Low Risk)</span>
              <span class="scenario-tag bg-emerald-500/20 text-emerald-400 border-emerald-500/40">Decision::Allow</span>
            </div>
            <p class="text-xs text-industrial-muted mt-1">최근 1시간 검사 결과 및 불량률 조회 -> 즉시 실행</p>
          </button>

          <button id="btn-scenario-deny" class="scenario-btn btn-deny-border">
            <div class="flex items-center justify-between">
              <span class="font-medium text-rose-300">③ 감사 로그 강제 초기화 (Destructive/Forbidden)</span>
              <span class="scenario-tag bg-rose-500/20 text-rose-400 border-rose-500/40">Decision::Deny</span>
            </div>
            <p class="text-xs text-industrial-muted mt-1">보안 정책 위반 금지 도구 호출 -> 즉시 차단 및 감사 기록 (write 0회)</p>
          </button>
        </div>

        <!-- Registered Tools Catalog -->
        <div class="bg-industrial-panel border border-industrial-border rounded-xl p-4 flex-1 flex flex-col min-h-0">
          <h2 class="text-sm font-semibold text-white mb-2 flex items-center justify-between">
            <span>ToolRegistry 활성 도구 (GET /api/tools)</span>
            <span class="text-xs font-mono text-industrial-muted">Coverage: Tier-G</span>
          </h2>
          <div id="tools-list" class="flex-1 overflow-y-auto space-y-2 pr-1">
            <!-- Tool items populated by JS -->
          </div>
        </div>
      </div>

      <!-- Right Column: Agent Chat & Audit Trail (7 cols) -->
      <div class="col-span-7 flex flex-col gap-4 min-h-0">
        <!-- Agent Chat Interaction Box -->
        <div class="bg-industrial-panel border border-industrial-border rounded-xl flex flex-col h-72 min-h-0">
          <div class="h-10 border-b border-industrial-border px-4 flex items-center justify-between shrink-0 bg-industrial-darker/50">
            <span class="text-xs font-semibold text-white flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-blue-400"></span>
              Agent Conversation Stream
            </span>
            <span class="text-xs text-industrial-muted">Inference: OpenAI Compatible / llama.cpp</span>
          </div>

          <!-- Messages Stream -->
          <div id="chat-messages" class="flex-1 p-4 overflow-y-auto space-y-3 font-sans text-sm">
            <div class="chat-msg chat-assistant">
              <span class="chat-sender text-emerald-400 font-semibold">Cogito++ Agent</span>
              <p>안녕하세요. 제조 설비 AI 에이전트 코어가 대기 중입니다. 작업지시 또는 설비 조회 명령을 입력하세요.</p>
            </div>
          </div>

          <!-- Chat Input Form -->
          <form id="chat-form" class="p-3 border-t border-industrial-border bg-industrial-darker/30 flex gap-2">
            <input id="chat-input" type="text" placeholder="자연어로 설비 명령을 입력하세요 (예: 불량 임계값 0.95로 변경해줘)..."
              class="flex-1 bg-industrial-dark border border-industrial-border rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500">
            <button type="submit" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-sm font-medium transition-colors">
              전송
            </button>
          </form>
        </div>

        <!-- Audit Trail Table -->
        <div class="bg-industrial-panel border border-industrial-border rounded-xl flex-1 flex flex-col min-h-0">
          <div class="h-10 border-b border-industrial-border px-4 flex items-center justify-between shrink-0 bg-industrial-darker/50">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
              <span class="text-xs font-semibold text-white">암호학적 감사 저널 (GET /api/audit)</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-xs px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 font-mono">
                Chain: Verified 🔒
              </span>
            </div>
          </div>

          <div class="flex-1 overflow-x-auto overflow-y-auto">
            <table class="w-full text-left text-xs">
              <thead class="bg-industrial-darker/80 text-industrial-muted font-mono sticky top-0 border-b border-industrial-border">
                <tr>
                  <th class="py-2 px-3">Seq</th>
                  <th class="py-2 px-3">Turn</th>
                  <th class="py-2 px-3">Event / Tool</th>
                  <th class="py-2 px-3">Verdict</th>
                  <th class="py-2 px-3">Action Digest</th>
                  <th class="py-2 px-3">Latency</th>
                </tr>
              </thead>
              <tbody id="audit-table-body" class="divide-y divide-industrial-border/40 font-mono">
                <!-- Populated by JS -->
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- §12-8 HMI Approval Modal Dialog (1024x768 No-Scroll Authority Area) -->
    <div id="approval-modal" class="hidden fixed inset-0 bg-black/85 backdrop-blur-sm z-50 flex items-center justify-center p-4">
      <div id="approval-authority-card" class="bg-industrial-panel border-2 border-amber-500 rounded-2xl w-full max-w-2xl flex flex-col shadow-2xl shadow-amber-500/20 overflow-hidden">
        
        <!-- Modal Header -->
        <div class="bg-amber-500/15 border-b border-amber-500/30 px-6 py-3.5 flex items-center justify-between shrink-0">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-amber-500/20 border border-amber-500/40 flex items-center justify-center text-amber-400">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                <line x1="12" y1="9" x2="12" y2="13"></line>
                <line x1="12" y1="17" x2="12.01" y2="17"></line>
              </svg>
            </div>
            <div>
              <h3 class="text-sm font-bold text-white tracking-wide">작업자 승인 요구 (PermissionGate: AwaitApproval)</h3>
              <p class="text-[11px] text-amber-300">고위험 설비 쓰기 명령이 감지되어 실행이 보류되었습니다.</p>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-[11px] px-2 py-0.5 rounded bg-amber-500/20 text-amber-300 font-mono border border-amber-500/40">
              Pending Approval
            </span>
          </div>
        </div>

        <!-- Modal Body (Authority Area [A-1]~[A-7]) -->
        <div class="p-5 flex flex-col gap-3 text-xs">
          <!-- Metadata Badges [A-1, A-2, A-3] -->
          <div class="grid grid-cols-3 gap-2.5">
            <div class="bg-industrial-darker p-2.5 rounded-lg border border-industrial-border">
              <span class="text-[11px] text-industrial-muted block">Target Tool</span>
              <span id="modal-tool-name" class="font-mono text-xs font-semibold text-white">opcua.set_inspection_threshold</span>
            </div>
            <div class="bg-industrial-darker p-2.5 rounded-lg border border-industrial-border">
              <span class="text-[11px] text-industrial-muted block">Risk & Effect [A-2]</span>
              <span id="modal-risk-badge" class="text-[10px] font-bold text-rose-400 bg-rose-500/20 px-1.5 py-0.5 rounded border border-rose-500/40">설비 변경 · 고위험</span>
            </div>
            <div class="bg-industrial-darker p-2.5 rounded-lg border border-industrial-border">
              <span class="text-[11px] text-industrial-muted block">Grammar & Policy [A-3]</span>
              <span id="modal-grammar-badge" class="text-[10px] text-amber-300 block font-medium">생성 단계 제약 없음 — 런타임 검증</span>
            </div>
          </div>

          <!-- Parameter Table [A-7] (Canonical fields table instead of JSON diff) -->
          <div class="bg-industrial-darker rounded-xl border border-industrial-border overflow-hidden">
            <div class="px-3.5 py-1.5 bg-industrial-border/30 border-b border-industrial-border flex items-center justify-between text-[11px]">
              <span class="font-semibold text-white">설비 권위 파라미터 표 (Authority Fields Table) [A-7]</span>
              <span id="modal-policy-rule" class="text-industrial-muted font-mono text-[10px]">rule: policy_opcua_write_01</span>
            </div>
            <table class="w-full text-left font-mono text-[11px]">
              <thead class="bg-industrial-darker/60 text-industrial-muted border-b border-industrial-border/60">
                <tr>
                  <th class="py-1 px-3">Field Name</th>
                  <th class="py-1 px-3 text-emerald-400">현재값 (Before)</th>
                  <th class="py-1 px-3 text-amber-300">요청값 (Requested)</th>
                </tr>
              </thead>
              <tbody id="modal-param-table-body" class="divide-y divide-industrial-border/30">
                <!-- Dynamically injected rows -->
              </tbody>
            </table>
          </div>

          <!-- Untrusted External Text Box [A-4] -->
          <div class="bg-industrial-darker/80 p-2.5 rounded-xl border border-dashed border-industrial-border">
            <div class="flex items-center justify-between text-[10px] text-industrial-muted mb-1 font-mono">
              <span class="text-rose-400 font-semibold">⚠️ 신뢰할 수 없는 외부 데이터 (Untrusted Model Output) [A-4]</span>
              <span id="modal-provenance">provenance: llama.cpp:q4_k_m</span>
            </div>
            <p id="modal-untrusted-text" class="text-industrial-muted font-sans text-xs whitespace-pre-wrap">
              설비 최적화를 위해 V1 비전 검사기 임계값을 0.95로 상향 조정하고자 합니다.
            </p>
          </div>

          <!-- Action Digest & Expiration Info [A-6] -->
          <div class="bg-industrial-darker/60 px-3.5 py-1.5 rounded-lg border border-industrial-border/60 flex items-center justify-between text-[11px] font-mono">
            <div>
              <span class="text-industrial-muted">Action Digest (앞 16자): </span>
              <span id="modal-action-digest-prefix" class="text-industrial-accent font-bold" title="">e3b0c44298fc1c14</span>
            </div>
            <div>
              <span class="text-industrial-muted">잔여 만료 시간 [A-6]: </span>
              <span id="modal-expires-countdown" class="text-amber-300 font-bold">120.0s</span>
            </div>
          </div>
        </div>

        <!-- §12-8 Compliant Modal Footer: Touch Target >= 56px, Button Gap >= 24px, 2-Step Confirmation [A-5] -->
        <div class="bg-industrial-darker border-t border-industrial-border px-6 py-3.5 flex items-center justify-end gap-6 shrink-0">
          <button id="btn-modal-reject" class="h-14 min-w-[140px] px-6 rounded-xl font-bold text-sm bg-rose-600/20 text-rose-300 border-2 border-rose-500 hover:bg-rose-600 hover:text-white transition-all flex items-center justify-center gap-2 active:scale-95">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
            거부 (Reject)
          </button>

          <button id="btn-modal-approve" class="h-14 min-w-[140px] px-6 rounded-xl font-bold text-sm bg-emerald-600 text-white border-2 border-emerald-400 hover:bg-emerald-500 shadow-lg shadow-emerald-600/30 transition-all flex items-center justify-center gap-2 active:scale-95">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span id="btn-approve-text">승인 (Approve)</span>
          </button>
        </div>

      </div>
    </div>
  </div>

  <script src="app.js"></script>
</body>
</html>
