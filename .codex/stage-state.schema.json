{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cogito.local/schemas/codex-stage-state-v3.json",
  "title": "Cogito++ Codex stage state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "active_ticket",
    "baseline_head_oid",
    "phase",
    "g0_gate",
    "contract_review",
    "contract_reference",
    "allowed_write_paths",
    "shared_write",
    "verification",
    "publication",
    "safety"
  ],
  "properties": {
    "$schema": { "const": "./stage-state.schema.json" },
    "schema_version": { "const": 3 },
    "active_ticket": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^S(?:[0-9]|1[01])-(?:0[1-9]|[1-9][0-9])$" }
      ]
    },
    "baseline_head_oid": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$" }
      ]
    },
    "phase": { "enum": ["idle", "preflight", "implementation", "verification", "complete", "blocked"] },
    "g0_gate": { "enum": ["not_passed", "passed"] },
    "contract_review": { "enum": ["not_run", "pass", "needs_claude", "blocked"] },
    "contract_reference": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] },
    "allowed_write_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/repositoryPath" }
    },
    "shared_write": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved", "paths", "reference"],
      "properties": {
        "approved": { "type": "boolean" },
        "paths": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/repositoryPath" } },
        "reference": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticket", "commands", "evidence_dir", "manifest_file", "verdict_file", "verifier", "stage_exit_gate", "head_oid", "workspace_fingerprint"],
      "properties": {
        "ticket": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^S(?:[0-9]|1[01])-(?:0[1-9]|[1-9][0-9])$" }] },
        "commands": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "evidence_dir": { "$ref": "#/$defs/nullablePath" },
        "manifest_file": { "$ref": "#/$defs/nullablePath" },
        "verdict_file": { "$ref": "#/$defs/nullablePath" },
        "verifier": { "enum": ["not_run", "pass", "fail", "incomplete_evidence"] },
        "stage_exit_gate": { "enum": ["not_evaluated", "pass", "fail", "incomplete_evidence"] },
        "head_oid": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] },
        "workspace_fingerprint": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }] }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit_authorized", "push_authorized", "merge_authorized", "pull_request_authorized", "release_authorized", "reference"],
      "properties": {
        "commit_authorized": { "type": "boolean" },
        "push_authorized": { "type": "boolean" },
        "merge_authorized": { "type": "boolean" },
        "pull_request_authorized": { "type": "boolean" },
        "release_authorized": { "type": "boolean" },
        "reference": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["destructive_git_authorized", "destructive_files_authorized", "reference"],
      "properties": {
        "destructive_git_authorized": { "type": "boolean" },
        "destructive_files_authorized": { "type": "boolean" },
        "reference": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] }
      }
    }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*:)(?!.*[. ](?:/|$))[^\\u0000]+$"
    },
    "nullablePath": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/repositoryPath" }] }
  }
}
