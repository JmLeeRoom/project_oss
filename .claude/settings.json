{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [".claude/hooks/session_context.py"],
            "timeout": 10,
            "statusMessage": "Cogito++ 역할·경계 컨텍스트 주입"
          }
        ]
      }
    ],

    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [".claude/hooks/cc_guard.py"],
            "timeout": 10,
            "statusMessage": "소유권·제어문자 검사"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [".claude/hooks/git_guard.py"],
            "if": "Bash(git *)",
            "timeout": 10,
            "statusMessage": "git 브랜치 가드"
          }
        ]
      }
    ]
  },

  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(git rev-parse*)",
      "Bash(cmake --version*)",
      "Bash(ctest --show-only*)",
      "Bash(vcpkg search*)",
      "Bash(vcpkg --version*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)"
    ]
  },

  "env": {
    "PYTHONIOENCODING": "utf-8",
    "PYTHONUTF8": "1"
  },

  "workflowSizeGuideline": "medium",

  "disableClaudeAiConnectors": true
}
