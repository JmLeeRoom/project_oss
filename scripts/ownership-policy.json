{
  "version": 2,
  "guard_contract": {
    "algorithm": "longest_prefix",
    "case_sensitive": false,
    "separator": "/",
    "fallback_owner": "deny"
  },
  "description": "Cogito++ Gemini-Codex 2-Agent ownership policy. Gemini owns prompts and contracts; Codex owns implementation and tests.",
  "owners": {
    "gemini": "Prompt, architecture, specification, public-header contract, configuration schema",
    "codex": "All implementation, build, automation, and tests including web and browser tests"
  },
  "rules": [
    { "prefix": ".agents/skills/cogito-stage-owner/", "owner": "codex" },
    { "prefix": "include/", "owner": "gemini" },
    { "prefix": "docs/", "owner": "gemini" },
    { "prefix": "config/", "owner": "gemini" },
    { "prefix": ".agents/", "owner": "gemini" },
    { "prefix": "GEMINI.md", "owner": "gemini" },
    { "prefix": "README.md", "owner": "gemini" },
    { "prefix": "LICENSE", "owner": "gemini" },
    { "prefix": "NOTICE", "owner": "gemini" },
    { "prefix": "THIRD_PARTY_LICENSES.md", "owner": "gemini" },
    { "prefix": "SECURITY.md", "owner": "gemini" },
    { "prefix": "CONTRIBUTING.md", "owner": "gemini" },
    { "prefix": "CODE_OF_CONDUCT.md", "owner": "gemini" },

    { "prefix": ".codex/", "owner": "codex" },
    { "prefix": "AGENTS.md", "owner": "codex" },
    { "prefix": "src/", "owner": "codex" },
    { "prefix": "tests/", "owner": "codex" },
    { "prefix": "cmake/", "owner": "codex" },
    { "prefix": "tools/", "owner": "codex" },
    { "prefix": "bindings/", "owner": "codex" },
    { "prefix": "scripts/", "owner": "codex" },
    { "prefix": ".github/", "owner": "codex" },
    { "prefix": ".gitignore", "owner": "codex" },
    { "prefix": ".gitattributes", "owner": "codex" },
    { "prefix": ".editorconfig", "owner": "codex" },
    { "prefix": ".clang-format", "owner": "codex" },
    { "prefix": ".clang-tidy", "owner": "codex" },
    { "prefix": "CMakeLists.txt", "owner": "codex" },
    { "prefix": "CMakePresets.json", "owner": "codex" },
    { "prefix": "vcpkg.json", "owner": "codex" },
    { "prefix": "vcpkg-configuration.json", "owner": "codex" }
  ],
  "notes": [
    "The user's explicit instruction overrides this routing table.",
    "Matching is case-insensitive because the primary workspace is on Windows.",
    "Unknown repository paths are denied until assigned to Gemini or Codex.",
    "Gemini supplies prompts and contracts. Codex implements and runs all tests, including dashboard, mock-server, and browser suites.",
    "The cogito-stage-owner skill remains Codex-owned inside the Gemini control directory."
  ]
}
