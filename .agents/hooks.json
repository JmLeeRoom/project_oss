{
  "boundary-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "^(write|write_file|write_to_file|replace|replace_in_file|replace_file_content|edit|create|create_file|delete|delete_file|remove|remove_file|move|move_file|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File ./scripts/guard-scope.ps1",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
