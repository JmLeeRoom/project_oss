{
  "boundary-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File ./scripts/guard-scope.ps1",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
